// Generated by zmk-layout --recommend --emit-keymap
// Review before flashing. Copy any extra layers from your existing
// .keymap if you need them — only the layers below are emitted.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        mouse_scroll: sensor_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9
                &kp N1 &kp W &kp F &kp P &kp B &kp J &kp L &kp U &kp Y &kp N0
                &kp TAB &kp Q &mt LSHFT R &mt LCTRL S &mt LALT T &mt LGUI G &mt LGUI M &mt LALT N &mt LCTRL E &mt LSHFT I &kp SEMI &kp SQT
                &kp LSHFT &kp A &kp X &kp C &kp D &kp V &kp K &kp H &kp COMMA &kp DOT &kp O &kp RSHFT
                &kp LCTRL &kp Z &kp LEFT &kp RIGHT &kp C_MUTE &kp DOWN &kp UP &kp FSLH &kp BSLH
                &kp LGUI &kp SPACE &sk LSHFT &kp DEL
                &mo 2 &kp ESC &kp RET &kp BSPC &mo 1
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        sym_layer {
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &kp TILDE &kp PIPE &kp LBRC &kp RBRC &kp LBKT &kp RBKT &kp EQUAL &kp PLUS &trans
                &trans &kp GRAVE &kp AT &kp HASH &kp DLLR &kp PRCNT &kp CARET &kp AMPS &kp STAR &kp LPAR &kp MINUS &trans
                &trans &kp EXCL &kp GT &kp UNDER &kp QMARK &kp BSLH &kp FSLH &kp COLON &kp SEMI &kp DQT &kp RPAR &trans
                &trans &kp LT &trans &trans &trans &trans &trans &kp SQT &trans
                &kp LGUI &kp SPACE &sk LSHFT &kp DEL
                &mo 2 &kp ESC &kp RET &kp BSPC &mo 1
            >;
            sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN>;
        };

        nav_layer {
            bindings = <
                &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9
                &kp F1 &kp C_VOL_DN &kp C_VOL_UP &kp C_BRI_DN &kp C_BRI_UP &kp HOME &kp PG_DN &kp PG_UP &kp END &kp F10
                &trans &kp C_MUTE &kp LALT &kp LCTRL &kp LSHFT &kp CAPS &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp INS &trans
                &trans &kp LGUI &kp LC(X) &kp LC(C) &kp LC(V) &kp PSCRN &kp TAB &kp ESC &kp DEL &kp BSPC &kp RET &trans
                &trans &kp LC(Z) &trans &trans &trans &trans &trans &kp K_APP &trans
                &kp LGUI &kp SPACE &sk LSHFT &kp DEL
                &mo 2 &kp ESC &kp RET &kp BSPC &mo 1
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };

        mouse_layer {
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &mkp MB1 &mkp MB2 &mkp MB3 &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans
                &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&mouse_scroll SCRL_DOWN SCRL_UP>;
        };
    };
};

// Generated by zmk-layout --recommend --emit-keymap
// Review before flashing. Copy any extra layers from your existing
// .keymap if you need them — only the layers below are emitted.

#define ZMK_POINTING_DEFAULT_SCRL_VAL 30

#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/msc_temp_layer.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hm: home_row_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        vim_save: vim_save {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESC &kp COLON &kp W &kp RET>;
        };

        vim_save_quit: vim_save_quit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESC &kp COLON &kp W &kp Q &kp RET>;
        };

        vim_force_quit: vim_force_quit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESC &kp COLON &kp Q &kp EXCL &kp RET>;
        };

        vim_top: vim_top {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESC &kp G &kp G>;
        };

        vim_bottom: vim_bottom {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESC &kp LS(G)>;
        };

        vim_dup_line: vim_dup_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESC &kp Y &kp Y &kp P>;
        };

        vim_del_line: vim_del_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESC &kp D &kp D>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                           &kp N2      &kp N3      &kp N4       &kp N5                 &kp N6   &kp N7       &kp N8      &kp N9
              &kp N1       &kp W       &kp E       &kp R        &kp T                  &kp Y    &kp U        &kp I       &kp O       &kp N0
&kp ESCAPE    &kp Q        &hm LALT S  &hm LGUI D  &hm LSHFT F  &kp G                  &kp H    &hm LSHFT J  &hm LGUI K  &hm LALT L  &kp P           &trans
&kp TAB       &hm LCTRL A  &kp X       &kp C       &kp V        &kp B                  &kp N    &kp M        &kp COMMA   &kp DOT     &hm LCTRL SEMI  &kp SINGLE_QUOTE
&kp CAPSLOCK  &kp Z        &kp LEFT    &kp RIGHT                         &kp C_MUTE                          &kp DOWN    &kp UP      &kp FSLH        &caps_word
                                       &mo 5       &kp SPACE    &mo 2                                        &mo 1
                                                   &mo 4        &kp ESC                &kp DEL  &kp RET      &kp BSPC
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        nav_layer {
            bindings = <
                          &trans      &trans                &trans                &trans                &trans  &trans         &trans    &trans
        &trans            &kp K_MUTE  &kp C_VOL_DN          &kp C_VOLUME_UP       &kp K_FIND            &trans  &kp PAGE_UP    &trans    &trans        &trans
&trans  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans                &trans  &kp LEFT       &kp DOWN  &kp UP_ARROW  &kp RIGHT  &trans
&trans  &kp C_PREVIOUS    &trans      &trans                &trans                &trans                &trans  &kp PAGE_DOWN  &trans    &trans        &trans     &trans
&trans  &trans            &trans      &trans                                                  &trans                           &trans    &trans        &trans     &trans
                                      &trans                &trans                &trans                                       &trans
                                                            &trans                &trans                &trans  &trans         &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };

        sym_layer {
            bindings = <
                   &trans  &trans         &trans            &trans               &trans     &trans         &trans     &trans
        &trans     &trans  &kp LESS_THAN  &kp GREATER_THAN  &trans               &trans     &kp PIPE       &kp UNDER  &kp LEFT_BRACE    &trans
&trans  &kp TILDE  &kp AT  &kp HASH       &kp DLLR          &kp PRCNT            &kp CARET  &kp AMPS       &kp STAR   &kp LPAR          &kp RIGHT_BRACE    &kp PLUS
&trans  &kp EXCL   &trans  &trans         &trans            &trans               &trans     &kp BACKSLASH  &kp MINUS  &kp LEFT_BRACKET  &kp RPAR           &trans
&trans  &kp GRAVE  &trans  &trans                                      &trans                              &trans     &trans            &kp RIGHT_BRACKET  &kp EQUAL
                           &trans         &trans            &trans                                         &trans
                                          &trans            &trans               &trans     &trans         &trans
            >;

            sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN>;
        };

        mouse_layer {
            bindings = <
                &trans  &trans  &trans  &trans            &trans    &trans    &trans    &trans
        &trans  &trans  &trans  &trans  &trans            &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans    &trans    &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &mkp MB1  &mkp MB2  &mkp MB3  &trans  &trans  &trans
&trans  &trans  &trans  &trans                  &trans                        &trans    &trans  &trans  &trans
                        &trans  &trans  &trans                                &trans
                                &trans  &trans            &trans    &trans    &trans
            >;

            sensor-bindings = <&msc_layer SCRL_DOWN SCRL_UP>;
        };

        bt_layer {
            bindings = <
                      &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4            &trans      &trans        &trans  &trans
        &bt BT_SEL 0  &trans        &trans        &trans        &trans                  &trans      &out OUT_USB  &trans  &trans  &trans
&trans  &bt BT_CLR    &trans        &trans        &trans        &trans                  &trans      &trans        &trans  &trans  &bt BT_PRV  &trans
&trans  &trans        &trans        &trans        &trans        &out OUT_BLE            &bt BT_NXT  &trans        &trans  &trans  &trans      &trans
&trans  &trans        &trans        &trans                                    &trans                              &trans  &trans  &trans      &trans
                                    &trans        &trans        &trans                                            &trans
                                                  &trans        &trans                  &trans      &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        flayer {
            bindings = <
                &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans   &trans
&trans  &trans  &kp F3  &kp F4  &kp F5  &kp F6            &kp F7  &kp F8  &kp F9  &kp F10  &trans   &trans
&kp F1  &kp F2  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans   &kp F11  &kp F12
&trans  &trans  &trans  &trans                  &trans                    &trans  &trans   &trans   &trans
                        &trans  &trans  &trans                            &trans
                                &trans  &trans            &trans  &trans  &trans
            >;
        };
    };
};

// Generated by zmk-layout --recommend --emit-keymap
// Review before flashing. Copy any extra layers from your existing
// .keymap if you need them — only the layers below are emitted.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#define ZMK_POINTING_DEFAULT_SCRL_VAL 30

#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/msc_temp_layer.dtsi>

/ {
    behaviors {
        hm: home_row_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        vim_save: vim_save {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESC &kp COLON &kp W &kp RET>;
        };
        vim_save_quit: vim_save_quit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESC &kp COLON &kp W &kp Q &kp RET>;
        };
        vim_force_quit: vim_force_quit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESC &kp COLON &kp Q &kp EXCL &kp RET>;
        };
        vim_top: vim_top {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESC &kp G &kp G>;
        };
        vim_bottom: vim_bottom {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESC &kp LS(G)>;
        };
        vim_dup_line: vim_dup_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESC &kp Y &kp Y &kp P>;
        };
        vim_del_line: vim_del_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESC &kp D &kp D>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9
                &kp N1 &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp N0
                &kp TAB &kp Q &hm LALT S &hm LGUI D &hm LSHFT F &kp G &kp H &hm LSHFT J &hm LGUI K &hm LALT L &kp P &kp SQT
                &caps_word &hm LCTRL A &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp DOT &hm LCTRL SEMI &kp LG(GRAVE)
                &mo 6 &kp Z &kp LEFT &kp RIGHT &kp C_MUTE &kp DOWN &kp UP &kp FSLH &kp BSLH
                &kp LGUI &kp SPACE &mo 4 &mo 1
                &mo 2 &lt 5 ESC &kp DEL &kp RET &kp BSPC
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        sym_layer {
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &kp TILDE &kp PIPE &kp LBRC &kp RBRC &kp LBKT &kp RBKT &kp EQUAL &kp PLUS &trans
                &trans &kp GRAVE &kp AT &kp HASH &kp DLLR &kp PRCNT &kp CARET &kp AMPS &kp STAR &kp LPAR &kp MINUS &trans
                &trans &kp EXCL &kp GT &kp UNDER &kp QMARK &kp BSLH &kp FSLH &kp COLON &kp SEMI &kp DQT &kp RPAR &trans
                &trans &kp LT &trans &trans &trans &trans &trans &kp SQT &trans
                &kp LGUI &kp SPACE &sk LSHFT &mo 1
                &mo 2 &kp ESC &kp DEL &kp RET &kp BSPC
            >;
            sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN>;
        };

        nav_layer {
            bindings = <
                &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9
                &kp F1 &kp C_VOL_DN &kp C_VOL_UP &kp C_BRI_DN &kp C_BRI_UP &kp HOME &kp PG_DN &kp PG_UP &kp END &kp F10
                &trans &kp C_MUTE &kp LALT &kp LCTRL &kp LSHFT &kp CAPS &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp INS &trans
                &trans &kp LGUI &kp LC(X) &kp LC(C) &kp LC(V) &kp PSCRN &kp TAB &kp ESC &kp DEL &kp BSPC &kp RET &trans
                &trans &kp LC(Z) &trans &trans &trans &trans &trans &kp K_APP &trans
                &kp LGUI &kp SPACE &sk LSHFT &mo 1
                &mo 2 &kp ESC &kp DEL &kp RET &kp BSPC
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };

        mouse_layer {
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &mkp MB1 &mkp MB2 &mkp MB3 &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans
                &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&msc_layer SCRL_DOWN SCRL_UP>;
        };

        cmd_layer {
            bindings = <
                &kp LG(N2) &kp LG(N3) &kp LG(N4) &kp LG(N5) &kp LG(N6) &kp LG(N7) &kp LG(N8) &kp LG(N9)
                &kp LG(N1) &kp LG(W) &kp LG(E) &kp LG(R) &kp LG(T) &kp LG(Y) &kp LG(U) &kp LG(I) &kp LG(O) &kp LG(N0)
                &kp LG(TAB) &kp LG(Q) &kp LG(S) &kp LG(D) &kp LG(F) &kp LG(G) &kp LG(H) &kp LG(J) &kp LG(K) &kp LG(L) &kp LG(P) &trans
                &trans &kp LG(A) &kp LG(X) &kp LG(C) &kp LG(V) &kp LG(B) &kp LG(N) &kp LG(M) &trans &trans &kp LG(SEMI) &trans
                &trans &kp LG(LS(Z)) &kp LC(LA(LEFT)) &kp LC(LA(RIGHT)) &trans &kp LC(LA(DOWN)) &kp LC(LA(UP)) &trans &trans
                &trans &kp LG(SPACE) &trans &trans
                &trans &trans &trans &kp LC(LA(RET)) &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        vim_layer {
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &vim_top &trans &trans &trans &trans &trans
                &trans &vim_save_quit &vim_save &vim_dup_line &trans &trans &trans &trans &vim_force_quit &trans &trans &trans
                &trans &trans &vim_del_line &trans &trans &vim_bottom &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans
                &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        bt_layer {
            bindings = <
                &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans &trans &trans &trans
                &bt BT_SEL 0 &trans &trans &trans &trans &trans &out OUT_USB &trans &trans &trans
                &trans &bt BT_CLR &trans &trans &trans &trans &trans &trans &trans &trans &bt BT_PRV &trans
                &trans &trans &trans &trans &trans &out OUT_BLE &bt BT_NXT &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans
                &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};

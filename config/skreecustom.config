# Enable ZMK Pointing subsystem so &msc, &mkp, &mouse_scroll, SCRL_*, and
# the input-processor pipeline (used by trackball listener) all compile in.
CONFIG_ZMK_POINTING=y
# Custom in-repo behavior: scroll wheel + temp layer keep-alive.
CONFIG_ZMK_BEHAVIOR_MSC_TEMP_LAYER=y

# === DEBUG LOGGING (temporary, for diagnosing scroll/layer races) ===
# Enables USB CDC serial logging. After flashing, connect to the keyboard's
# USB serial port (e.g. screen /dev/tty.usbmodem* 115200 on macOS) to read
# LOG_DBG output from our behavior. Remove these lines for production
# firmware (they cost ~10KB flash + add USB CDC overhead).
CONFIG_ZMK_USB_LOGGING=y
CONFIG_LOG_DEFAULT_LEVEL=4

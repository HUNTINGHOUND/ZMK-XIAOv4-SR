/*
 * Default node declaration. Users can override `layer` and `time-ms` by
 * redeclaring `msc_layer` in their keymap.
 */

/ {
    behaviors {
        /omit-if-no-ref/ msc_layer: msc_layer {
            compatible = "zmk,behavior-msc-temp-layer";
            #binding-cells = <1>;
            layer = <3>;
            time-ms = <500>;
        };
    };
};
